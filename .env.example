# ---------------------------------------------------------------------------
# Arthiq AI service - example configuration
#
# Copy to .env and fill in. .env is gitignored; this file holds placeholders
# only and must never contain a real key.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# -- Application ------------------------------------------------------------
APP_ENV=development
APP_NAME=arthiq-ai
LOG_LEVEL=INFO
ENABLE_DOCS=true
INTERNAL_API_PREFIX=/internal/v1
# Comma-separated. Normally empty: the caller is a server, not a browser.
CORS_ORIGINS=

# -- Service-to-service authentication --------------------------------------
# The shared secret the backend sends as the X-API-Key header. This
# authenticates the calling *service*; end users are authenticated by the
# backend and are never known to this service.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Comma-separated values are accepted so a key can be rotated without downtime:
#   AI_SERVICE_API_KEY=new-key,old-key
# Leave it unset and every internal call is refused (fails closed).
AI_SERVICE_API_KEY=replace-with-a-generated-secret

# -- Provider selection -----------------------------------------------------
# ollama (default, local) | gemini (cloud) | fake (deterministic, offline)
AI_PROVIDER=ollama

# Hard ceiling on a single provider call, in seconds.
AI_REQUEST_TIMEOUT_SECONDS=30
# Response cap. The cheapest cost control there is.
AI_MAX_OUTPUT_TOKENS=768
# 0.0 keeps decisions as reproducible as the provider allows.
AI_TEMPERATURE=0.0

# -- Context bounds ---------------------------------------------------------
# How much of the caller's history may reach the prompt.
CONTEXT_MAX_RECENT_CLOSES=20
CONTEXT_MAX_OBSERVATIONS=10

# -- Observability ----------------------------------------------------------
# Business content, off by default. Turn on locally when debugging a prompt.
LOG_PROMPTS=false
LOG_PROVIDER_RESPONSES=false

# -- Ollama (local development) ---------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Set to a model you have pulled, e.g. `ollama pull qwen3:8b`.
# No model is hard-coded in the source; this must be set to use Ollama.
OLLAMA_MODEL=
# Optional stronger local model used when a request asks for depth=DEEP.
OLLAMA_DEEP_MODEL=
# Set to false for a reasoning model (qwen3, deepseek-r1): its thinking chain is
# discarded by this service but still consumes the output budget. Leave unset
# for a model that has no thinking mode - it rejects the field.
OLLAMA_THINK=

# -- Gemini (cloud) ---------------------------------------------------------
GEMINI_API_KEY=
# Explicit, pinned model ids only. A floating "-latest" alias is rejected at
# startup, because a model that moves makes a recorded decision irreproducible.
# Routine / low-cost analysis:
GEMINI_MODEL=gemini-2.5-flash-lite
# Deeper analysis, used only for depth=DEEP requests:
GEMINI_DEEP_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
